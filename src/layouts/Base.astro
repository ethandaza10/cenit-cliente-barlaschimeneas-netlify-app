---
import '@fontsource/bebas-neue';
import '@fontsource-variable/caveat';
import '@fontsource-variable/libre-franklin';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { site, link } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Ruta canónica, p. ej. "/carta". Por defecto la actual. */
  path?: string;
  /** Nodos JSON-LD adicionales (FAQPage, Menu, etc.). */
  schema?: Record<string, unknown>[];
  /** true → esta página NO se indexa (legales, gracias…). No aparece en Google ni en el sitemap. */
  noindex?: boolean;
}

const { title, description, path, schema = [], noindex = false } = Astro.props;

const canonicalPath = path ?? Astro.url.pathname;
// Origen del sitio realmente desplegado (Astro.site), con fallback.
const siteBase = Astro.site?.href ?? `${site.domain}/`;
// Canonical = origen + base + ruta (link() añade la base de GitHub Pages).
const canonical = new URL(link(canonicalPath), siteBase).href;
const businessUrl = new URL(link('/'), siteBase).href;

// Indexable en el DOMINIO REAL del cliente; noindex solo en hosts de preview/comparación
// (pages.dev, workers.dev, netlify, localhost) para no competir con la web viva. SITE_INDEXABLE=true fuerza.
const isPreviewHost = /(netlify\.app|pages\.dev|workers\.dev|localhost|127\.0\.0\.1)/i.test(Astro.site?.host || '');
const indexable = process.env.SITE_INDEXABLE === 'true' || !isPreviewHost;
// noindex por página (legales, etc.) manda: se rastrea pero no se indexa. Si no, según el host.
const robotsContent = noindex ? 'noindex, follow' : (indexable ? 'index, follow' : 'noindex, nofollow');

// Nodo LocalBusiness común a todas las páginas (datos verificados).
const business = {
  '@context': 'https://schema.org',
  '@type': 'BarOrPub',
  '@id': `${businessUrl}#business`,
  name: site.name,
  url: businessUrl,
  telephone: site.phoneTel,
  priceRange: '€€',
  servesCuisine: site.cuisine,
  image: new URL(link('/favicon.png'), siteBase).href,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.streetSchema,
    postalCode: site.postalCode,
    addressLocality: site.city,
    addressRegion: site.region,
    addressCountry: site.country,
  },
  openingHours: site.hoursSchema,
  foundingDate: site.founded,
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: String(site.rating),
    reviewCount: String(site.reviews),
  },
};

const jsonLd = [business, ...schema];
---

<!doctype html>
<html lang="es">
  <head>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robotsContent} />
    <meta name="theme-color" content="#20241a" />
    <link rel="icon" type="image/png" href={link('/favicon.png')} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_ES" />

    <link rel="sitemap" href={link('/sitemap-index.xml')} />

    {
      jsonLd.map((node) => (
        <script type="application/ld+json" set:html={JSON.stringify(node)} />
      ))
    }
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <CookieBanner />

    <script>
      // Motion con criterio: aparición al hacer scroll. Sólo transform/opacity.
      // Respeta prefers-reduced-motion (el CSS ya deja todo visible en ese caso).
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const items = document.querySelectorAll('[data-reveal]');
      if (reduce || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                obs.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 }
        );
        items.forEach((el) => io.observe(el));
      }

      // Header: estado "condensado" al bajar.
      const header = document.querySelector('[data-header]');
      if (header) {
        const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 24);
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
      }

      // Menú móvil.
      const toggle = document.querySelector('[data-menu-toggle]');
      const nav = document.querySelector('[data-menu]');
      if (toggle && nav) {
        toggle.addEventListener('click', () => {
          const open = nav.classList.toggle('is-open');
          toggle.setAttribute('aria-expanded', String(open));
        });
        nav.querySelectorAll('a').forEach((a) =>
          a.addEventListener('click', () => {
            nav.classList.remove('is-open');
            toggle.setAttribute('aria-expanded', 'false');
          })
        );
      }
    </script>
  </body>
</html>
