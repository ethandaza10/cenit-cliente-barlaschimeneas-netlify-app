---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import { telLink, waLink, site } from '../data/site';

// SOLO fotos reales del cliente (mapa en /assets/manifest.json). No se inventa ninguna.
import hero from '../assets/musica-directo.jpg';
import ambiente1 from '../assets/ambiente-terraza.jpg';
import ambiente2 from '../assets/ambiente-2.jpg';

const faq = [
  {
    q: '¿Cuándo hay música en vivo en Bar Las Chimeneas?',
    a: 'Solemos organizar conciertos, música en directo o eventos gastronómicos cada 15 días aproximadamente; según el mes, al menos una vez al mes. Pregúntanos por el próximo evento para no perdértelo.',
  },
  {
    q: '¿Se puede reservar para un grupo o una celebración?',
    a: 'Sí. Escríbenos por WhatsApp o reserva a través de la web indicando el número de personas y la fecha. Para grupos y eventos conviene avisar con antelación porque las plazas en terraza son limitadas.',
  },
  {
    q: '¿Dónde estáis?',
    a: 'Estamos en Valdemorillo (Madrid), en el corazón de la Casa de la Cultura. Es un punto de encuentro fácil de localizar en el pueblo.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base
  title="Música en Vivo en Valdemorillo | Bar Las Chimeneas"
  description="Conciertos, música en vivo y eventos cada quincena en Valdemorillo. Celebra tu cumpleaños o comida de empresa en Bar Las Chimeneas. Reserva tu mesa."
  path="/eventos-musica-en-vivo"
  schema={[faqSchema]}
>
  <!-- Hero editorial -->
  <section class="hero">
    <div class="container hero__grid">
      <div data-reveal>
        <span class="hand hero__hand">los findes, en directo</span>
        <span class="eyebrow">Eventos · Valdemorillo</span>
        <h1 class="display hero__title">
          Música en vivo en Valdemorillo: la agenda de Bar Las Chimeneas
        </h1>
        <p class="lead">
          Conciertos y eventos en directo aproximadamente cada quincena, con terraza y ambiente familiar.
        </p>
        <div class="btn-row">
          <a class="btn btn--lg" href={waLink}>Consultar agenda por WhatsApp</a>
          <a class="btn btn--ghost btn--lg" href={telLink}>Llamar</a>
        </div>
      </div>
      <div class="frame hero__frame" data-reveal style="--reveal-delay:80ms">
        <Image
          src={hero}
          alt="Música en vivo en Bar Las Chimeneas, con la terraza como escenario."
          width={640}
          height={480}
          loading="eager"
          fetchpriority="high"
          format="webp" densities={[1, 2]}
          quality={82}
        />
      </div>
    </div>
  </section>

  <!-- Qué encontrarás -->
  <section class="section">
    <div class="container two">
      <div data-reveal>
        <span class="eyebrow">Cada quincena</span>
        <h2 class="h-xl">Un plan diferente cada quincena en el corazón de Valdemorillo</h2>
      </div>
      <div class="prose" data-reveal style="--reveal-delay:80ms">
        <p>
          En Bar Las Chimeneas la buena comida siempre viene acompañada de ambiente. Ubicados junto a
          la Casa de la Cultura de Valdemorillo, organizamos conciertos en directo, música en vivo y
          eventos gastronómicos aproximadamente cada 15 días (según el mes, al menos una vez al mes).
          Es nuestra forma de entender la hostelería: que cada visita sea una experiencia y no solo
          una consumición. Si buscas música en vivo en Valdemorillo con raciones caseras, terraza y
          trato cercano, este es tu sitio.
        </p>
      </div>
    </div>
  </section>

  <!-- Agenda (pendiente) -->
  <section class="section paper">
    <div class="container split">
      <div class="split__copy" data-reveal>
        <span class="eyebrow">La programación</span>
        <h2 class="h-lg">Agenda de eventos y conciertos</h2>
        <div class="prose">
          <p>
            Nuestra agenda va cambiando cada semana, así que la mejor forma de saber quién toca y a
            qué hora es consultarnos directamente antes de venir. En cuanto tengamos publicada la
            programación del mes, aquí verás fechas, estilos musicales y horarios para que elijas el
            día que más te encaje.
          </p>
        </div>
        <p class="pending">Publicaremos aquí la programación del mes en cuanto esté cerrada. Mientras tanto, pregúntanos por el próximo evento.</p>
        <a class="btn" href={waLink}>Escríbenos y te contamos qué hay este finde</a>
      </div>
      <div class="frame split__media" data-reveal style="--reveal-delay:80ms">
        <Image
          src={ambiente1}
          alt="Ambiente del Bar Las Chimeneas en una sobremesa de fin de semana."
          width={560}
          height={560}
          format="webp" densities={[1, 2]}
          quality={82}
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- Fútbol + eventos privados -->
  <section class="section">
    <div class="container two-col">
      <article class="card panel" data-reveal>
        <h2 class="h-lg">¿Ponéis el fútbol y otros deportes?</h2>
        <div class="prose">
          <p>
            Muchos vecinos nos preguntan por los partidos. Si vienes a ver algún partido concreto,
            escríbenos y te confirmamos si lo emitimos y te guardamos sitio.
          </p>
        </div>
        <p class="pending">
          ¿Vienes con tu grupo a ver un partido concreto? Escríbenos y te confirmamos qué tenemos
          previsto ese día.
        </p>
      </article>
      <article class="card panel" data-reveal style="--reveal-delay:80ms">
        <h2 class="h-lg">Celebraciones y eventos privados</h2>
        <div class="prose">
          <p>
            Un cumpleaños, una reunión de amigos o una celebración especial encajan de maravilla en
            nuestra terraza y con nuestras raciones para compartir. Cuéntanos qué tienes en mente y
            vemos juntos cómo montarlo para que salga perfecto.
          </p>
        </div>
        <p class="pending">
          ¿Tienes una fecha en mente? Escríbenos y te preparamos una propuesta personalizada, con
          menú a medida para tu celebración.
        </p>
      </article>
    </div>
  </section>

  <!-- Cómo reservar -->
  <section class="section paper">
    <div class="container split split--reverse">
      <div class="split__copy" data-reveal>
        <span class="eyebrow">Reservas</span>
        <h2 class="h-lg">Cómo reservar mesa o grupo</h2>
        <div class="prose">
          <p>
            Reservar es sencillo: puedes hacerlo por WhatsApp o pidiendo mesa a través de la web.
            Para grupos grandes o si vienes por un evento concreto, avísanos con antelación porque
            las plazas en terraza son limitadas. Así nos aseguramos de tenerte todo listo cuando
            llegues.
          </p>
        </div>
        <div class="btn-row">
          <a class="btn" href={waLink}>Reservar por WhatsApp</a>
          <a class="btn btn--ghost" href={telLink}>{site.phoneDisplay}</a>
        </div>
      </div>
      <div class="frame split__media" data-reveal style="--reveal-delay:80ms">
        <Image
          src={ambiente2}
          alt="Rincón del Bar Las Chimeneas preparado para recibir a un grupo."
          width={560}
          height={560}
          format="webp" densities={[1, 2]}
          quality={82}
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <Faq items={faq} />
</Base>

<style>
  .hero {
    padding-block: clamp(var(--sp-7), 7vw, var(--sp-9)) var(--sp-7);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(var(--sp-6), 5vw, var(--sp-8));
    align-items: center;
  }
  .hero__hand {
    display: block;
    font-size: clamp(1.5rem, 3.4vw, 2.3rem);
    transform: rotate(-2deg);
    transform-origin: left;
    margin-bottom: var(--sp-2);
  }
  .hero__title {
    margin: var(--sp-3) 0 var(--sp-5);
    max-width: 16ch;
  }
  .hero__frame {
    aspect-ratio: 4 / 3;
  }

  .two {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(var(--sp-5), 4vw, var(--sp-8));
    align-items: start;
  }
  .two h2 {
    margin-top: var(--sp-3);
  }

  .split {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(var(--sp-6), 5vw, var(--sp-8));
    align-items: center;
  }
  .split__copy h2 {
    margin: var(--sp-3) 0 var(--sp-4);
  }
  .split__copy .btn,
  .split__copy .btn-row {
    margin-top: var(--sp-5);
  }
  .split__media {
    aspect-ratio: 1 / 1;
  }

  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-5);
  }
  .panel {
    padding: clamp(var(--sp-5), 3vw, var(--sp-6));
  }
  .panel h2 {
    margin-bottom: var(--sp-4);
  }

  @media (max-width: 860px) {
    .hero__grid { grid-template-columns: 1fr; }
    .hero__grid > div:first-child { order: 2; }
    .two,
    .split,
    .two-col { grid-template-columns: 1fr; }
    .split--reverse .split__copy { order: 2; }
  }
</style>
