---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import { site, telLink, waLink, link } from '../data/site';

import hero from '../assets/local-interior.jpg';
import musica from '../assets/musica-directo.jpg';
import postre from '../assets/ambiente-terraza.jpg';
import croquetas from '../assets/croquetas.png';
import huevosRotos from '../assets/huevos-rotos.png';
import raboDeToro from '../assets/rabo-de-toro.jpg';
import tortilla from '../assets/tortilla.png';
import hamburguesa from '../assets/hamburguesa.png';
import tarta from '../assets/tarta-queso.jpg';

// Imagen LCP (hero): se genera aquí para poder PRECARGARLA en el <head> (mejora el LCP).
const HERO_SIZES = '(max-width: 860px) 100vw, 52vw';
const HERO_WIDTHS = [560, 860, 1100, 1600, 2000];
const heroLcp = await getImage({
  src: hero,
  widths: HERO_WIDTHS,
  sizes: HERO_SIZES,
  format: 'webp',
  quality: 82,
});

// SOLO fotos reales del cliente (mapa en /assets/manifest.json). No se inventa ninguna.
const carousel = [
  { img: croquetas, label: 'Croquetas caseras', alt: 'Ración de croquetas caseras de Bar Las Chimeneas.' },
  { img: huevosRotos, label: 'Huevos rotos', alt: 'Plato de huevos rotos de Bar Las Chimeneas, para compartir.' },
  { img: raboDeToro, label: 'Rabo de toro al vino tinto', alt: 'Rabo de toro guisado en salsa de vino tinto.' },
  { img: tortilla, label: 'Tortilla de la casa', alt: 'Tortilla de patata casera de Bar Las Chimeneas.' },
  { img: hamburguesa, label: 'Hamburguesa gourmet', alt: 'Hamburguesa gourmet de la carta de Bar Las Chimeneas.' },
  { img: tarta, label: 'Tarta de queso casera', alt: 'Porción de tarta de queso casera con mermelada de arándanos.' },
];

const faq = [
  {
    q: '¿Dónde está Bar Las Chimeneas en Valdemorillo?',
    a: 'Estamos en la Casa de la Cultura de Valdemorillo (Madrid), un espacio céntrico y de fácil acceso. Contamos con terraza y un ambiente familiar y acogedor.',
  },
  {
    q: '¿Qué horario tiene el bar?',
    a: 'Abrimos de lunes a viernes de 9:00 a 23:00 y los sábados de 13:00 a 17:00 y de 19:00 a 23:00. Los domingos permanecemos cerrados.',
  },
  {
    q: '¿Ofrecen menú del día?',
    a: 'Sí. El menú del día es nuestra especialidad y se elabora cada día con recetas diferentes, cocina casera con un toque premium preparada al momento por nuestro chef.',
  },
  {
    q: '¿Se puede reservar mesa?',
    a: 'Sí, recomendamos reservar, sobre todo para la terraza y los días con menú o evento en directo. Contáctanos para confirmar tu mesa.',
  },
  {
    q: '¿Es un sitio para ir en familia o en grupo?',
    a: 'Totalmente. Es un local familiar y acogedor, ideal para familias, parejas, trabajadores y grupos de amigos que buscan buena comida, buen ambiente y una excelente relación calidad-precio.',
  },
];

// Reseñas reales de clientes recogidas en el copy del kit.
const reviews = [
  { t: 'Dani cocina de lujo, cada día un menú diferente que sorprende. Todo buenísimo y el servicio excelente.', a: 'Reseña de cliente en Google' },
  { t: 'La comida exquisita y el trato del personal es espectacular. Volveremos.', a: 'Reseña de cliente en Google' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/\[.*?\]/g, '').trim() },
  })),
};

const proofs = [
  { k: '4,8 ★', v: `Valoración en Google (${site.reviews} reseñas) por la cocina y el trato cercano.` },
  { k: '13,90 €', v: 'Menú del día casero, con recetas diferentes elaboradas al momento cada jornada.' },
  { k: 'Desde 2025', v: 'Danny Barrios cambió el concepto: en un año, uno de los bares de referencia del pueblo.' },
  { k: 'En directo', v: 'Conciertos y eventos cada quincena; terraza y ambiente familiar.' },
];
---

<Base
  title="Restaurante en Valdemorillo | Las Chimeneas"
  description="Restaurante en Valdemorillo con menú del día casero, tapas, terraza y música en vivo. Ambiente familiar en Las Chimeneas. Reserva tu mesa por WhatsApp."
  path="/"
  schema={[faqSchema]}
>
  <!-- Precarga de la imagen LCP (hero) para bajar el LCP -->
  <link
    slot="head"
    rel="preload"
    as="image"
    href={heroLcp.src}
    imagesrcset={heroLcp.srcSet.attribute}
    imagesizes={HERO_SIZES}
    fetchpriority="high"
  />

  <!-- HERO: foto a media pantalla con fundido hacia la pizarra -->
  <section class="hero">
    <div class="hero__media">
      <Image
        src={hero}
        alt="Interior del Bar Las Chimeneas: barra de ladrillo y ambiente familiar en Valdemorillo."
        widths={HERO_WIDTHS}
        sizes={HERO_SIZES}
        loading="eager"
        fetchpriority="high"
        format="webp"
        quality={82}
      />
    </div>
    <div class="container hero__inner">
      <div class="hero__copy">
        <span class="hand hero__hand">aquí te sentirás como en casa</span>
        <span class="eyebrow">Bar · Menú del día · Música en vivo</span>
        <h1 class="display hero__title">
          Restaurante en Valdemorillo — Las Chimeneas
        </h1>
        <p class="lead">
          Bar y restaurante familiar en el corazón de Valdemorillo: menú del día casero que cambia
          cada jornada, tapas para compartir y eventos en directo. Te atendemos por tu nombre.
        </p>
        <div class="btn-row hero__cta">
          <a class="btn" href={waLink}>Reservar por WhatsApp</a>
          <a class="btn btn--ghost" href={link('/carta')}>Ver el menú del día</a>
        </div>
        <ul class="trust">
          <li><strong>4,8 ★</strong> Google · {site.reviews} reseñas</li>
          <li>Menú del día 13,90 €</li>
          <li>Ambiente familiar y terraza</li>
          <li>Eventos en directo</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- INTRO: Danny 2025 -->
  <section class="section">
    <div class="container intro">
      <div class="intro__copy" data-reveal>
        <span class="eyebrow">Desde 2025, nuevo concepto</span>
        <h2 class="h-xl">Un bar y restaurante en Valdemorillo pensado para que te quedes</h2>
        <div class="prose">
          <p>
            Bar Las Chimeneas es mucho más que un sitio donde tomar algo: es un lugar acogedor en
            pleno corazón de Valdemorillo, dentro de la Casa de Cultura, donde vienes a comer bien y
            te quedas por el ambiente. Desde 2025, <strong>Danny Barrios</strong> ha cogido las
            riendas del local y ha cambiado por completo el concepto, apostando por una cocina casera
            con un toque creativo elaborada al momento con ingredientes de calidad. En solo un año,
            ese trabajo ha convertido a Las Chimeneas en uno de los bares y restaurantes de
            referencia de Valdemorillo.
          </p>
        </div>
      </div>
      <div class="intro__fig" data-reveal style="--reveal-delay:80ms">
        <div class="frame">
          <Image
            src={postre}
            alt="Postre casero de fresas con nata de Bar Las Chimeneas."
            width={620}
            height={640}
            format="webp" densities={[1, 2]}
            quality={82}
            loading="lazy"
          />
        </div>
        <span class="stamp intro__stamp">¡bienvenido!</span>
      </div>
    </div>
  </section>

  <!-- MENÚ DEL DÍA (protagonista) — banda premium con foto de fondo -->
  <section class="menudia-band">
    <div class="band-bg">
      <Image src={raboDeToro} alt="Plato del menú del día de Bar Las Chimeneas en Valdemorillo" width={1600} height={1000} format="webp" quality={70} loading="lazy" />
    </div>
    <div class="container menudia" data-reveal>
      <aside class="pizarra" aria-label="Menú del día">
        <span class="pizarra__hand">nuestra seña de identidad</span>
        <h2 class="pizarra__title">Menú del día</h2>
        <p class="pizarra__price">13,90 €</p>
        <ul class="pizarra__list">
          <li>Primer plato</li>
          <li>Segundo plato</li>
          <li>Bebida</li>
          <li>Postre</li>
        </ul>
        <p class="pizarra__foot">Recetas diferentes cada jornada, elaboradas al momento.</p>
      </aside>
      <div class="menudia__copy">
        <span class="eyebrow">La mesa</span>
        <h2 class="h-lg">Comer en Valdemorillo: menú del día, tapas y platos para compartir</h2>
        <div class="prose">
          <p>
            Nuestra seña de identidad es el <strong>menú del día</strong>, elaborado cada jornada con
            recetas diferentes salidas de la creatividad de nuestro chef: comida de calidad con un
            toque premium, <strong>porque todos merecen comer al mejor nivel</strong>. Y si prefieres
            picar y compartir, nuestras tapas y raciones caseras son famosas en el municipio:
            croquetas caseras, secreto ibérico, solomillo con romesco de avellanas, hamburguesas
            gourmet y postres caseros que no querrás dejar en el plato.
          </p>
        </div>
        <a class="link-gold" href={link('/carta')}>Ver la carta del restaurante y el menú del día →</a>
      </div>
    </div>
  </section>

  <!-- CARRUSEL DE TAPAS REALES -->
  <section class="section carousel-sec">
    <div class="container">
      <div class="carousel-sec__head" data-reveal>
        <span class="eyebrow">De nuestra cocina</span>
        <h2 class="h-lg">Algunas de nuestras tapas y platos</h2>
      </div>
    </div>
    <div class="carousel" role="region" aria-label="Algunas de nuestras tapas y platos">
      <ul class="carousel__track">
        {
          carousel.map((c, i) => (
            <li class="carousel__item" data-reveal style={`--reveal-delay:${i * 50}ms`}>
              <div class="frame">
                <Image src={c.img} alt={c.alt} width={420} height={300} format="webp" densities={[1, 2]} quality={82} loading="lazy" />
                <span class="frame__cap">{c.label}</span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- TERRAZA / EVENTOS: banda a sangre con capa vermut -->
  <section class="eventos-band">
    <div class="band-bg">
      <Image src={musica} alt="Terraza del Bar Las Chimeneas en Valdemorillo durante un concierto en vivo" width={1900} height={900} format="webp" quality={72} loading="lazy" />
    </div>
    <div class="container eventos-band__inner" data-reveal>
      <span class="hand eventos-band__hand">los findes, en directo</span>
      <h2 class="eventos-band__title">Ambiente familiar, terraza <span class="accent">y eventos en directo</span></h2>
      <p class="eventos-band__text">
        Las Chimeneas es un local acogedor con terraza y un ambiente familiar, ideal para venir con la
        familia, en pareja o con un grupo de amigos. Aquí caben los vecinos que buscan su menú del día,
        los que quieren unas tapas tranquilos y los que se acercan a nuestros conciertos y eventos en
        directo, parte habitual de nuestra programación.
      </p>
      <div class="btn-row eventos-band__cta">
        <a class="btn" href={waLink}>Reservar mesa para el finde</a>
        <a class="btn btn--ghost" href={link('/eventos-musica-en-vivo')}>Ver la agenda</a>
      </div>
    </div>
  </section>

  <!-- POR QUÉ ELEGIRNOS -->
  <section class="section section--tight">
    <div class="container">
      <div class="why__head" data-reveal>
        <span class="eyebrow">Por qué nosotros</span>
        <h2 class="h-xl">Por qué elegir Las Chimeneas frente a otros bares del pueblo</h2>
        <p class="prose">
          Lo que nos diferencia es una cocina casera que cambia constantemente, con menús del día
          creativos y platos elaborados al momento. Organizamos música y eventos en directo, cuidamos
          el trato —aquí te atienden con nombre y sonrisa— y buscamos que salgas con ganas de volver.
          Detrás está Danny Barrios y un equipo comprometido con la calidad y la atención al cliente.
        </p>
      </div>
      <ul class="why">
        {
          proofs.map((p, i) => (
            <li class="why__row" data-reveal style={`--reveal-delay:${i * 60}ms`}>
              <span class="why__k">{p.k}</span>
              <span class="why__v">{p.v}</span>
            </li>
          ))
        }
      </ul>

      <ul class="quotes" aria-label="Lo que dicen nuestros clientes">
        {
          reviews.map((r, i) => (
            <li class="quote" data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <p class="quote__t">“{r.t}”</p>
              <p class="quote__a">{r.a}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- DÓNDE / RESERVAR -->
  <section class="section paper">
    <div class="container split split--reverse">
      <div class="split__copy" data-reveal>
        <span class="eyebrow">Dónde estamos</span>
        <h2 class="h-lg">Ven a vernos o reserva tu mesa</h2>
        <div class="prose">
          <p>
            Nos encuentras en la Casa de la Cultura de Valdemorillo (Madrid). Las plazas en terraza
            son limitadas, así que si vienes en grupo o en fin de semana te recomendamos reservar
            mesa por WhatsApp con antelación.
          </p>
        </div>
        <dl class="facts">
          <div><dt>Dirección</dt><dd>{site.addressFull}</dd></div>
          <div><dt>Teléfono</dt><dd><a class="link-gold" href={telLink}>{site.phoneDisplay}</a></dd></div>
          <div><dt>Horario</dt><dd>{site.hoursDisplay}</dd></div>
        </dl>
        <div class="btn-row">
          <a class="btn" href={waLink}>Reservar por WhatsApp</a>
          <a class="btn btn--ghost" href={link('/contacto')}>Cómo llegar</a>
        </div>
      </div>
      <div class="frame map" data-reveal style="--reveal-delay:80ms">
        <iframe
          src={site.mapsEmbed}
          title="Mapa de la ubicación de Bar Las Chimeneas en Valdemorillo"
          width="600"
          height="440"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>

  <Faq items={faq} />
</Base>

<style>
  /* HERO — foto a media pantalla con fundido hacia la pizarra */
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .hero__media {
    position: absolute;
    inset: 0 0 0 auto;
    width: 52%;
    z-index: -1;
  }
  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Fundido: el borde izquierdo de la foto se mezcla con el fondo pizarra */
  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--ink) 2%, rgba(32, 36, 26, 0.55) 22%, transparent 55%);
  }
  .hero__inner {
    display: flex;
    align-items: center;
    min-height: min(86vh, 760px);
    padding-block: clamp(var(--sp-7), 6vw, var(--sp-9));
  }
  .hero__copy {
    max-width: 34rem;
  }
  .hero__hand {
    display: block;
    font-size: clamp(1.6rem, 3.6vw, 2.5rem);
    transform: rotate(-2deg);
    transform-origin: left;
    margin-bottom: var(--sp-3);
  }
  .hero__title {
    margin-block: var(--sp-3) var(--sp-5);
    max-width: 18ch;
  }
  .hero__cta { flex-wrap: wrap; }

  .trust {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3) var(--sp-5);
    align-items: center;
    list-style: none;
    padding: var(--sp-5) 0 0;
    margin-top: var(--sp-6);
    border-top: 1px dashed var(--line-strong);
    color: var(--cream-dim);
    font-size: var(--step--1);
    letter-spacing: 0.02em;
  }
  .trust li { display: inline-flex; align-items: center; gap: var(--sp-2); }
  .trust li + li::before { content: '·'; color: var(--amber); margin-right: var(--sp-3); }
  .trust strong { color: var(--amber-bright); font-family: var(--font-display); font-size: 1.15rem; }

  @media (max-width: 860px) {
    /* Móvil: foto primero (arriba), luego el copy — como pediste */
    .hero { display: flex; flex-direction: column; }
    .hero__media {
      position: relative;
      width: 100%;
      height: 42vh;
      inset: auto;
      z-index: 0;
      order: -1;
    }
    .hero__media::after {
      background: linear-gradient(0deg, var(--ink) 2%, transparent 60%);
    }
    .hero__inner { min-height: 0; padding-top: var(--sp-6); }
  }

  /* INTRO: texto izquierda + foto (postre) derecha con sello */
  .intro {
    display: grid;
    grid-template-columns: 1.02fr 0.98fr;
    gap: clamp(var(--sp-6), 5vw, var(--sp-8));
    align-items: center;
  }
  .intro__copy h2 { margin: var(--sp-3) 0 var(--sp-4); }
  .intro__fig { position: relative; }
  .intro__fig .frame { aspect-ratio: 4 / 5; }
  .intro__fig .frame img { width: 100%; height: 100%; object-fit: cover; }
  .intro__stamp {
    position: absolute;
    top: var(--sp-4);
    right: calc(-1 * var(--sp-3));
    font-size: 1.9rem;
    z-index: 4;
    box-shadow: var(--shadow-soft);
  }
  @media (max-width: 780px) {
    .intro { grid-template-columns: 1fr; }
    .intro__fig .frame { aspect-ratio: 4 / 3; }
  }

  /* Capa de fondo compartida para bandas a sangre */
  .band-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }
  .band-bg img { width: 100%; height: 100%; object-fit: cover; }

  /* Banda del MENÚ DEL DÍA — foto de fondo + capa cálida oscura */
  .menudia-band {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-block: clamp(var(--sp-8), 8vw, var(--sp-10));
    color: var(--cream);
  }
  .menudia-band .band-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(20, 24, 16, 0.86), rgba(20, 24, 16, 0.92)),
      radial-gradient(120% 100% at 15% 0%, rgba(176, 74, 47, 0.42), transparent 60%);
  }
  .menudia {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(var(--sp-6), 5vw, var(--sp-8));
    align-items: center;
  }
  .menudia__copy h2 { margin: var(--sp-3) 0 var(--sp-4); }
  .menudia__copy .prose { color: var(--cream-dim); }
  .menudia__copy .prose strong { color: var(--amber-bright); font-weight: 600; }
  .menudia__copy .link-gold { display: inline-block; margin-top: var(--sp-5); }
  @media (max-width: 780px) {
    .menudia { grid-template-columns: 1fr; }
    .menudia .pizarra { margin-inline: auto; }
  }

  /* Banda de TERRAZA / EVENTOS — foto a sangre + capa vermut */
  .eventos-band {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-block: clamp(var(--sp-9), 11vw, var(--sp-10));
    text-align: center;
  }
  .eventos-band .band-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(28, 12, 8, 0.62), rgba(28, 12, 8, 0.72)),
      radial-gradient(120% 120% at 50% 40%, rgba(176, 74, 47, 0.5), rgba(20, 24, 16, 0.55) 75%);
  }
  .eventos-band__inner { max-width: 760px; margin-inline: auto; }
  .eventos-band__hand { font-size: clamp(1.7rem, 3.4vw, 2.5rem); color: var(--amber-bright); }
  .eventos-band__title {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: var(--step-3);
    line-height: 0.96;
    letter-spacing: 0.02em;
    color: #fff;
    margin: var(--sp-2) 0 var(--sp-4);
  }
  .eventos-band__title .accent { color: var(--amber); }
  .eventos-band__text { color: #f4e6de; max-width: 56ch; margin: 0 auto var(--sp-6); }
  .eventos-band__cta { justify-content: center; }
  .eventos-band__cta .btn--ghost { color: #fff; border-color: rgba(255, 255, 255, 0.5); }
  .eventos-band__cta .btn--ghost:hover { border-color: var(--amber-bright); color: var(--amber-bright); background: rgba(255,255,255,0.08); }

  /* Sección del carrusel de tapas */
  .carousel-sec { padding-bottom: clamp(var(--sp-7), 6vw, var(--sp-8)); }
  .carousel-sec__head { margin-bottom: var(--sp-5); }
  .carousel-sec__head h2 { margin-top: var(--sp-2); }

  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(var(--sp-6), 5vw, var(--sp-8));
    align-items: center;
  }
  .split__media {
    aspect-ratio: 1 / 1;
  }
  .split__copy h2 {
    margin: var(--sp-3) 0 var(--sp-4);
  }
  .split__copy .link-gold {
    display: inline-block;
    margin-top: var(--sp-5);
  }

  /* Reseñas reales */
  .quotes {
    list-style: none;
    padding: 0;
    margin-top: var(--sp-7);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-4);
  }
  .quote {
    padding: var(--sp-5) var(--sp-6);
    background: var(--surface);
    border: 1px solid var(--line);
    border-left: 3px solid var(--amber);
    border-radius: var(--radius-m);
  }
  .quote__t {
    font-family: var(--font-hand);
    font-size: 1.7rem;
    line-height: 1.3;
    color: var(--cream);
  }
  .quote__a {
    margin-top: var(--sp-3);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--amber);
  }
  @media (max-width: 720px) {
    .quotes { grid-template-columns: 1fr; }
  }

  /* Carrusel */
  .carousel {
    margin-top: var(--sp-7);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: var(--gold) transparent;
  }
  .carousel__track {
    display: flex;
    gap: var(--sp-4);
    list-style: none;
