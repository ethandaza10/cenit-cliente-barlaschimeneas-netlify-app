---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import { site, telLink, waLink, link } from '../data/site';

import hero from '../assets/local-interior.jpg';
import musica from '../assets/musica-directo.jpg';
import croquetas from '../assets/croquetas.png';
import huevosRotos from '../assets/huevos-rotos.png';
import raboDeToro from '../assets/rabo-de-toro.jpg';
import tortilla from '../assets/tortilla.png';
import hamburguesa from '../assets/hamburguesa.png';
import tarta from '../assets/tarta-queso.jpg';

// SOLO fotos reales del cliente (mapa en /assets/manifest.json). No se inventa ninguna.
const carousel = [
  { img: croquetas, label: 'Croquetas caseras', alt: 'Ración de croquetas caseras de Bar Las Chimeneas.' },
  { img: huevosRotos, label: 'Huevos rotos', alt: 'Plato de huevos rotos de Bar Las Chimeneas, para compartir.' },
  { img: raboDeToro, label: 'Rabo de toro al vino tinto', alt: 'Rabo de toro guisado en salsa de vino tinto.' },
  { img: tortilla, label: 'Tortilla de la casa', alt: 'Tortilla de patata casera de Bar Las Chimeneas.' },
  { img: hamburguesa, label: 'Hamburguesa gourmet', alt: 'Hamburguesa gourmet de la carta de Bar Las Chimeneas.' },
  { img: tarta, label: 'Tarta de queso casera', alt: 'Porción de tarta de queso casera con mermelada de arándanos.' },
];

const faq = [
  {
    q: '¿Dónde está Bar Las Chimeneas en Valdemorillo?',
    a: 'Estamos en la Casa de la Cultura de Valdemorillo (Madrid), un espacio céntrico y de fácil acceso. Contamos con terraza y un ambiente familiar y acogedor.',
  },
  {
    q: '¿Qué horario tiene el bar?',
    a: 'Abrimos de lunes a viernes de 9:00 a 23:00 y los sábados de 13:00 a 17:00 y de 19:00 a 23:00. Los domingos permanecemos cerrados.',
  },
  {
    q: '¿Ofrecen menú del día?',
    a: 'Sí. El menú del día es nuestra especialidad y se elabora cada día con recetas diferentes, cocina casera con un toque premium preparada al momento por nuestro chef.',
  },
  {
    q: '¿Se puede reservar mesa?',
    a: 'Sí, recomendamos reservar, sobre todo para la terraza y los días con menú o evento en directo. Contáctanos para confirmar tu mesa.',
  },
  {
    q: '¿Es un sitio para ir en familia o en grupo?',
    a: 'Totalmente. Es un local familiar y acogedor, ideal para familias, parejas, trabajadores y grupos de amigos que buscan buena comida, buen ambiente y una excelente relación calidad-precio.',
  },
];

// Reseñas reales de clientes recogidas en el copy del kit.
const reviews = [
  { t: 'Dani cocina de lujo, cada día un menú diferente que sorprende. Todo buenísimo y el servicio excelente.', a: 'Reseña de cliente en Google' },
  { t: 'La comida exquisita y el trato del personal es espectacular. Volveremos.', a: 'Reseña de cliente en Google' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/\[.*?\]/g, '').trim() },
  })),
};

const proofs = [
  { k: '4,8 ★', v: `Valoración en Google (${site.reviews} reseñas) por la cocina y el trato cercano.` },
  { k: '13,90 €', v: 'Menú del día casero, con recetas diferentes elaboradas al momento cada jornada.' },
  { k: 'Desde 2025', v: 'Danny Barrios cambió el concepto: en un año, uno de los bares de referencia del pueblo.' },
  { k: 'En directo', v: 'Conciertos y eventos cada quincena; terraza y ambiente familiar.' },
];
---

<Base
  title="Bar en Valdemorillo | Las Chimeneas · Cocina y Terraza"
  description="Bar en Valdemorillo con menú del día casero, tapas, terraza y música en vivo. Ambiente familiar en la Casa de Cultura. Reserva tu mesa en Las Chimeneas."
  path="/"
  schema={[faqSchema]}
>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <span class="hand hero__hand">aquí te sentirás como en casa</span>
        <span class="eyebrow">Bar · Menú del día · Música en vivo</span>
        <h1 class="display hero__title">
          Bar Las Chimeneas: cocina casera, terraza y música en el corazón de Valdemorillo
        </h1>
        <p class="lead">
          Menú del día casero que cambia cada jornada, tapas para compartir y eventos en directo.
          Un local familiar donde te atendemos por tu nombre.
        </p>
        <div class="btn-row hero__cta">
          <a class="btn" href={waLink}>Reservar por WhatsApp</a>
          <a class="btn btn--ghost" href={link('/carta')}>Ver el menú del día</a>
        </div>
      </div>

      <div class="hero__media" data-reveal>
        <div class="frame hero__frame">
          <Image
            src={hero}
            alt="Interior del Bar Las Chimeneas: barra de ladrillo y ambiente familiar en Valdemorillo."
            width={720}
            height={480}
            loading="eager"
            fetchpriority="high"
            format="webp" densities={[1, 2]}
            quality={82}
          />
        </div>
        <span class="hero__ember" aria-hidden="true"></span>
      </div>
    </div>

    <div class="container">
      <ul class="trust">
        <li><strong>4,8 ★</strong> Google · {site.reviews} reseñas</li>
        <li>Menú del día 13,90 €</li>
        <li>Ambiente familiar y terraza</li>
        <li>Eventos en directo</li>
      </ul>
    </div>
  </section>

  <!-- INTRO: Danny 2025 -->
  <section class="section">
    <div class="container two" >
      <div data-reveal>
        <span class="eyebrow">Desde 2025, nuevo concepto</span>
        <h2 class="h-xl">Un bar en Valdemorillo pensado para que te quedes</h2>
      </div>
      <div class="prose" data-reveal style="--reveal-delay:80ms">
        <p>
          Bar Las Chimeneas es mucho más que un sitio donde tomar algo: es un lugar acogedor en pleno
          corazón de Valdemorillo, dentro de la Casa de Cultura, donde vienes a comer bien y te quedas
          por el ambiente. Desde 2025, Danny Barrios ha cogido las riendas del local y ha cambiado por
          completo el concepto, apostando por una cocina casera con un toque creativo elaborada al
          momento con ingredientes de calidad. En solo un año, ese trabajo ha convertido a Las
          Chimeneas en uno de los bares de referencia del pueblo.
        </p>
      </div>
    </div>
  </section>

  <!-- MENÚ DEL DÍA (protagonista) + CARRUSEL DE TAPAS REALES -->
  <section class="section paper">
    <div class="container">
      <div class="menudia" data-reveal>
        <aside class="pizarra" aria-label="Menú del día">
          <span class="pizarra__hand">nuestra seña de identidad</span>
          <h2 class="pizarra__title">Menú del día</h2>
          <p class="pizarra__price">13,90 €</p>
          <ul class="pizarra__list">
            <li>Primer plato</li>
            <li>Segundo plato</li>
            <li>Bebida</li>
            <li>Postre</li>
          </ul>
          <p class="pizarra__foot">Recetas diferentes cada jornada, elaboradas al momento.</p>
        </aside>
        <div class="menudia__copy">
          <span class="eyebrow">La mesa</span>
          <h2 class="h-lg">Menú del día, tapas y platos para compartir</h2>
          <div class="prose">
            <p>
              Nuestra seña de identidad es el menú del día, elaborado cada jornada con recetas
              diferentes salidas de la creatividad de nuestro chef: comida de calidad con un toque
              premium, porque todos merecen comer al mejor nivel. Y si prefieres picar y compartir,
              nuestras tapas y raciones caseras son famosas en el municipio: croquetas caseras,
              secreto ibérico, solomillo con romesco de avellanas, hamburguesas gourmet y postres
              caseros que no querrás dejar en el plato.
            </p>
          </div>
          <a class="link-gold" href={link('/carta')}>Ver la carta y el menú del día →</a>
        </div>
      </div>
    </div>

    <div class="carousel" role="region" aria-label="Algunas de nuestras tapas y platos">
      <ul class="carousel__track">
        {
          carousel.map((c, i) => (
            <li class="carousel__item" data-reveal style={`--reveal-delay:${i * 50}ms`}>
              <div class="frame">
                <Image src={c.img} alt={c.alt} width={420} height={300} format="webp" densities={[1, 2]} quality={82} loading="lazy" />
                <span class="frame__cap">{c.label}</span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- TERRAZA / MÚSICA -->
  <section class="section">
    <div class="container split">
      <div class="frame split__media" data-reveal>
        <Image
          src={musica}
          alt="Música en vivo en el Bar Las Chimeneas, con la terraza como escenario."
          width={620}
          height={620}
          format="webp" densities={[1, 2]}
          quality={82}
          loading="lazy"
        />
        <span class="frame__cap">en directo, cada quincena</span>
      </div>
      <div class="split__copy" data-reveal style="--reveal-delay:80ms">
        <span class="eyebrow">Terraza · familia · directo</span>
        <h2 class="h-lg">Ambiente familiar, terraza y eventos en directo</h2>
        <div class="prose">
          <p>
            Las Chimeneas es un local acogedor con terraza y un ambiente familiar, ideal para venir
            con la familia, en pareja o con un grupo de amigos. Aquí caben los vecinos que buscan su
            menú del día, los que quieren tomar unas tapas tranquilos y los que se acercan a
            disfrutar de nuestros conciertos y eventos en directo, parte habitual de nuestra
            programación. Cuidamos cada detalle del servicio para que cada visita sea una experiencia
            completa, no solo una comida.
          </p>
        </div>
        <a class="link-gold" href={link('/eventos-musica-en-vivo')}>Ver la agenda de eventos →</a>
      </div>
    </div>
  </section>

  <!-- POR QUÉ ELEGIRNOS -->
  <section class="section section--tight">
    <div class="container">
      <div class="why__head" data-reveal>
        <span class="eyebrow">Por qué nosotros</span>
        <h2 class="h-xl">Por qué elegir Las Chimeneas frente a otros bares del pueblo</h2>
        <p class="prose">
          Lo que nos diferencia es una cocina casera que cambia constantemente, con menús del día
          creativos y platos elaborados al momento. Organizamos música y eventos en directo, cuidamos
          el trato —aquí te atienden con nombre y sonrisa— y buscamos que salgas con ganas de volver.
          Detrás está Danny Barrios y un equipo comprometido con la calidad y la atención al cliente.
        </p>
      </div>
      <ul class="why">
        {
          proofs.map((p, i) => (
            <li class="why__row" data-reveal style={`--reveal-delay:${i * 60}ms`}>
              <span class="why__k">{p.k}</span>
              <span class="why__v">{p.v}</span>
            </li>
          ))
        }
      </ul>

      <ul class="quotes" aria-label="Lo que dicen nuestros clientes">
        {
          reviews.map((r, i) => (
            <li class="quote" data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <p class="quote__t">“{r.t}”</p>
              <p class="quote__a">{r.a}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- DÓNDE / RESERVAR -->
  <section class="section paper">
    <div class="container split split--reverse">
      <div class="split__copy" data-reveal>
        <span class="eyebrow">Dónde estamos</span>
        <h2 class="h-lg">Ven a vernos o reserva tu mesa</h2>
        <div class="prose">
          <p>
            Nos encuentras en la Casa de la Cultura de Valdemorillo (Madrid). Las plazas en terraza
            son limitadas, así que si vienes en grupo o en fin de semana te recomendamos reservar
            mesa por WhatsApp con antelación.
          </p>
        </div>
        <dl class="facts">
          <div><dt>Dirección</dt><dd>{site.addressFull}</dd></div>
          <div><dt>Teléfono</dt><dd><a class="link-gold" href={telLink}>{site.phoneDisplay}</a></dd></div>
          <div><dt>Horario</dt><dd>{site.hoursDisplay}</dd></div>
        </dl>
        <div class="btn-row">
          <a class="btn" href={waLink}>Reservar por WhatsApp</a>
          <a class="btn btn--ghost" href={link('/contacto')}>Cómo llegar</a>
        </div>
      </div>
      <div class="frame map" data-reveal style="--reveal-delay:80ms">
        <iframe
          src={site.mapsEmbed}
          title="Mapa de la ubicación de Bar Las Chimeneas en Valdemorillo"
          width="600"
          height="440"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>

  <Faq items={faq} />
</Base>

<style>
  /* HERO */
  .hero {
    position: relative;
    padding-block: clamp(var(--sp-7), 7vw, var(--sp-9)) var(--sp-7);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(var(--sp-6), 5vw, var(--sp-8));
    align-items: center;
  }
  .hero__hand {
    display: block;
    font-size: clamp(1.6rem, 3.6vw, 2.5rem);
    transform: rotate(-2deg);
    transform-origin: left;
    margin-bottom: var(--sp-3);
  }
  .hero__title {
    margin-block: var(--sp-3) var(--sp-5);
    max-width: 16ch;
  }
  /* CTA del hero: los dos botones, juntos y en una fila */
  .hero__cta {
    flex-wrap: nowrap;
  }
  @media (max-width: 480px) {
    .hero__cta {
      flex-wrap: wrap;
    }
    .hero__cta .btn {
      flex: 1 1 auto;
    }
  }
  .hero__media {
    position: relative;
  }
  .hero__frame {
    aspect-ratio: 3 / 2;
    transform: rotate(0.6deg);
  }
  .hero__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__ember {
    position: absolute;
    inset: -18% -12% auto auto;
    width: 55%;
    aspect-ratio: 1;
    background: radial-gradient(circle, rgba(217, 107, 63, 0.35), transparent 65%);
    filter: blur(24px);
    z-index: -1;
    animation: ember 7s ease-in-out infinite alternate;
  }
  @keyframes ember {
    from { transform: translate3d(0, 0, 0) scale(1); opacity: 0.75; }
    to { transform: translate3d(-8px, 10px, 0) scale(1.08); opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__ember { animation: none; }
    .hero__frame { transform: none; }
  }

  .trust {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3) var(--sp-6);
    align-items: center;
    list-style: none;
    padding: var(--sp-5) 0 0;
    margin-top: var(--sp-6);
    border-top: 1px solid var(--line);
    color: var(--cream-dim);
    font-size: var(--step--1);
    letter-spacing: 0.02em;
  }
  .trust li {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
  }
  .trust li + li::before {
    content: '·';
    color: var(--gold);
    margin-right: var(--sp-4);
  }
  .trust strong {
    color: var(--gold-bright);
    font-family: var(--font-display);
    font-size: 1.05rem;
  }

  /* Bloques de dos columnas */
  .two {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(var(--sp-5), 4vw, var(--sp-8));
    align-items: start;
  }
  .two--head {
    align-items: end;
    margin-bottom: var(--sp-6);
  }
  .two h2 {
    margin-top: var(--sp-3);
  }

  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(var(--sp-6), 5vw, var(--sp-8));
    align-items: center;
  }
  .split__media {
    aspect-ratio: 1 / 1;
  }
  .split__copy h2 {
    margin: var(--sp-3) 0 var(--sp-4);
  }
  .split__copy .link-gold {
    display: inline-block;
    margin-top: var(--sp-5);
  }

  /* Menú del día (pizarra + copy) */
  .menudia {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(var(--sp-6), 5vw, var(--sp-8));
    align-items: center;
  }
  .menudia__copy h2 {
    margin: var(--sp-3) 0 var(--sp-4);
  }
  .menudia__copy .link-gold {
    display: inline-block;
    margin-top: var(--sp-5);
  }
  @media (max-width: 780px) {
    .menudia {
      grid-template-columns: 1fr;
    }
    .menudia .pizarra {
      margin-inline: auto;
    }
  }

  /* Reseñas reales */
  .quotes {
    list-style: none;
    padding: 0;
    margin-top: var(--sp-7);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-4);
  }
  .quote {
    padding: var(--sp-5) var(--sp-6);
    background: var(--surface);
    border: 1px solid var(--line);
    border-left: 3px solid var(--amber);
    border-radius: var(--radius-m);
  }
  .quote__t {
    font-family: var(--font-hand);
    font-size: 1.7rem;
    line-height: 1.3;
    color: var(--cream);
  }
  .quote__a {
    margin-top: var(--sp-3);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--amber);
  }
  @media (max-width: 720px) {
    .quotes { grid-template-columns: 1fr; }
  }

  /* Carrusel */
  .carousel {
    margin-top: var(--sp-7);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: var(--gold) transparent;
  }
  .carousel__track {
    display: flex;
    gap: var(--sp-4);
    list-style: none;
    padding: 0 var(--sp-5) var(--sp-4);
    width: max-content;
  }
  .carousel__item {
    scroll-snap-align: start;
    flex: 0 0 clamp(240px, 32vw, 340px);
  }
  .carousel__item .frame {
    aspect-ratio: 7 / 5;
  }

  /* Por qué */
  .why__head {
    max-width: 62ch;
    margin-bottom: var(--sp-6);
  }
  .why__head h2 {
    margin: var(--sp-3) 0 var(--sp-4);
  }
  .why {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .why__row {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: var(--sp-5);
    align-items: baseline;
    padding: var(--sp-5) 0;
    border-bottom: 1px solid var(--line);
  }
  .why__k {
    font-family: var(--font-display);
    font-size: var(--step-2);
    color: var(--gold-bright);
    line-height: 1;
  }
  .why__v {
    color: var(--cream-dim);
    max-width: 52ch;
  }

  /* Facts + mapa */
  .facts {
    display: grid;
    gap: var(--sp-3);
    margin: var(--sp-5) 0 var(--sp-6);
  }
  .facts div {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: var(--sp-4);
    padding-block: var(--sp-2);
    border-bottom: 1px solid rgba(120, 80, 30, 0.2);
  }
  .facts dt {
    font-weight: 800;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ember-ink);
    padding-top: 3px;
  }
  .facts dd {
    color: #4a382a;
  }
  .map {
    aspect-ratio: 4 / 3;
  }
  .map iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (max-width: 860px) {
    .hero__grid { grid-template-columns: 1fr; }
    .hero__media { order: -1; }
    .two,
    .split { grid-template-columns: 1fr; }
    .split--reverse .split__copy { order: 2; }
    .why__row { grid-template-columns: 1fr; gap: var(--sp-2); }
    .why__k { font-size: var(--step-1); }
  }
</style>
