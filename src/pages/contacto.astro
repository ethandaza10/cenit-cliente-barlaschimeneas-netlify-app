---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import { site, telLink, waLink } from '../data/site';

// Datos verificados (ver src/data/site.ts). El copy del kit citaba
// "Calle Real 15" y "918 99 88 77": datos sin corroborar y contradichos por
// tres fuentes. Se sustituyen por los reales; el resto del copy se respeta.
const faq = [
  {
    q: '¿Cuál es la dirección de Bar Las Chimeneas en Valdemorillo?',
    a: `Estamos en la ${site.addressFull}, un punto céntrico y muy conocido del municipio.`,
  },
  {
    q: '¿Cuál es el teléfono para reservar?',
    a: `Puedes llamarnos o escribirnos por WhatsApp al ${site.phoneDisplay}. Te atenderemos para reservar mesa o resolver cualquier duda.`,
  },
  {
    q: '¿Qué horario tenéis?',
    a: 'Abrimos de lunes a viernes de 9:00 a 23:00 y los sábados de 13:00 a 17:00 y de 19:00 a 23:00. Los domingos permanecemos cerrados.',
  },
  {
    q: '¿Hay aparcamiento cerca?',
    a: 'Sí. Muy cerca del establecimiento hay aparcamiento público y el acceso es sencillo, tanto si vienes en coche como andando desde el centro.',
  },
  {
    q: '¿Cómo reservo mesa en la terraza?',
    a: `Llámanos o mándanos un WhatsApp al ${site.phoneDisplay} indicando día, hora y número de personas. En terraza las plazas son limitadas, así que mejor reservar con antelación, sobre todo los fines de semana.`,
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base
  title="Contacto Bar Las Chimeneas Valdemorillo | Reserva"
  description="¿Quieres venir al Bar Las Chimeneas en Valdemorillo? Aquí tienes dirección, teléfono, cómo llegar y cómo reservar mesa. Terraza y música en vivo."
  path="/contacto"
  schema={[faqSchema]}
>
  <section class="section--tight page-head">
    <div class="container">
      <span class="hand" data-reveal style="display:block;font-size:clamp(1.5rem,3.4vw,2.3rem);transform:rotate(-2deg);transform-origin:left;margin-bottom:var(--sp-2)">te guardamos sitio</span>
      <span class="eyebrow" data-reveal>Contacto y reservas</span>
      <h1 class="display" data-reveal>Contacto y reservas — Bar Las Chimeneas Valdemorillo</h1>
      <p class="lead" data-reveal style="--reveal-delay:80ms">
        Estamos en el corazón de Valdemorillo, en la Casa de la Cultura. Si quieres reservar mesa,
        preguntar por la terraza o consultar el próximo concierto, lo más rápido es llamarnos o
        escribirnos por WhatsApp. Te contesta una persona de verdad: aquí te conocemos por tu nombre.
      </p>
    </div>
  </section>

  <!-- Bloque de datos + mapa -->
  <section class="section" style="padding-top:0">
    <div class="container contact">
      <div class="contact__card card" data-reveal>
        <dl class="datos">
          <div>
            <dt>Dirección</dt>
            <dd>{site.addressFull}</dd>
          </div>
          <div>
            <dt>Teléfono y WhatsApp</dt>
            <dd><a class="link-gold" href={telLink}>{site.phoneDisplay}</a></dd>
          </div>
          <div>
            <dt>Horario</dt>
            <dd>{site.hoursDisplay}</dd>
          </div>
          <div>
            <dt>Valoración</dt>
            <dd><span class="stars" aria-hidden="true">★★★★★</span> {site.rating} en Google · {site.reviews} reseñas</dd>
          </div>
        </dl>
        <div class="btn-row">
          <a class="btn btn--lg" href={waLink}>Reservar por WhatsApp</a>
          <a class="btn btn--ghost btn--lg" href={telLink}>Llamar ahora</a>
        </div>
      </div>

      <div class="frame contact__map" data-reveal style="--reveal-delay:80ms">
        <iframe
          src={site.mapsEmbed}
          title="Mapa de la ubicación de Bar Las Chimeneas en Valdemorillo"
          width="600"
          height="520"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- Reservar / Llegar / Horario -->
  <section class="section paper section--tight">
    <div class="container info-grid">
      <article data-reveal>
        <h2 class="h-lg">Cómo reservar mesa</h2>
        <div class="prose">
          <p>
            Reservar es sencillo. Llámanos o mándanos un WhatsApp al {site.phoneDisplay} indicándonos
            el día, la hora y cuántos vais a ser. Si os apetece la terraza, avísanos al reservar: las
            plazas al aire libre son limitadas, sobre todo los fines de semana y los días con menú o
            evento en directo. Te confirmamos la mesa en el momento.
          </p>
        </div>
      </article>

      <article data-reveal style="--reveal-delay:60ms">
        <h2 class="h-lg">Cómo llegar y aparcamiento</h2>
        <div class="prose">
          <p>
            El Bar Las Chimeneas está dentro de la Casa de la Cultura de Valdemorillo, un punto muy
            conocido y de fácil acceso en el municipio. Cerca del establecimiento dispones de
            aparcamiento público, así que llegar en coche y encontrar sitio no será un problema.
          </p>
        </div>
      </article>

      <article data-reveal style="--reveal-delay:120ms">
        <h2 class="h-lg">Horario de apertura</h2>
        <div class="prose">
          <p>
            Abrimos de lunes a viernes de 9:00 a 23:00 y los sábados de 13:00 a 17:00 y de 19:00 a
            23:00. Los domingos permanecemos cerrados. Antes de venir a un evento concreto, puedes
            confirmar el horario del día llamándonos o consultando nuestra ficha de Google.
          </p>
        </div>
      </article>
    </div>
  </section>

  <!-- Cierre -->
  <section class="section section--tight">
    <div class="container two" data-reveal>
      <div>
        <span class="eyebrow">Un plan que merece la visita</span>
        <h2 class="h-xl">Algo más que una consumición</h2>
      </div>
      <div class="prose">
        <p>
          Desde 2025, con Danny Barrios al frente, Las Chimeneas se ha convertido en uno de los
          sitios favoritos de Valdemorillo para comer, compartir y disfrutar: menú del día casero que
          cambia cada jornada, tapas para compartir, terraza y un ambiente familiar donde te
          atendemos por tu nombre. Si buscas algo más que una consumición, este es tu sitio.
          Escríbenos y reserva tu mesa.
        </p>
        <div class="btn-row" style="margin-top:var(--sp-5)">
          <a class="btn" href={waLink}>Reservar por WhatsApp</a>
        </div>
      </div>
    </div>
  </section>

  <Faq items={faq} />
</Base>

<style>
  .page-head {
    padding-top: clamp(var(--sp-7), 6vw, var(--sp-8));
  }
  .page-head .display {
    margin: var(--sp-4) 0 var(--sp-5);
    max-width: 20ch;
  }
  .page-head .lead {
    max-width: 62ch;
  }

  .contact {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(var(--sp-5), 4vw, var(--sp-7));
    align-items: stretch;
  }
  .contact__card {
    padding: clamp(var(--sp-5), 3vw, var(--sp-7));
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .datos {
    display: grid;
    gap: var(--sp-4);
    margin-bottom: var(--sp-6);
  }
  .datos div {
    display: grid;
    gap: 4px;
    padding-bottom: var(--sp-4);
    border-bottom: 1px solid var(--line);
  }
  .datos dt {
    font-weight: 800;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .datos dd {
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: var(--cream);
  }
  .stars {
    color: var(--gold-bright);
    letter-spacing: 1px;
  }
  .contact__map {
    min-height: 360px;
  }
  .contact__map iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(var(--sp-5), 4vw, var(--sp-7));
  }
  .info-grid h2 {
    margin-bottom: var(--sp-4);
  }

  .two {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(var(--sp-5), 4vw, var(--sp-8));
    align-items: start;
  }
  .two h2 {
    margin-top: var(--sp-3);
  }

  @media (max-width: 860px) {
    .contact,
    .info-grid,
    .two {
      grid-template-columns: 1fr;
    }
    .contact__map {
      min-height: 320px;
      aspect-ratio: 4 / 3;
    }
  }
</style>
