---
import Base from '../layouts/Base.astro';
import { telLink } from '../data/site';
---

<Base title="Página no encontrada | Bar Las Chimeneas" description="La página que buscas no existe. Vuelve al inicio de Bar Las Chimeneas en Valdemorillo." path="/404">
  <section class="section" style="text-align:center;min-height:52vh;display:grid;place-content:center;gap:var(--sp-4)">
    <div class="container">
      <span class="eyebrow" style="justify-content:center">Error 404</span>
      <h1 class="display" style="margin:var(--sp-4) 0">Esta mesa no existe</h1>
      <p class="lead" style="margin-inline:auto">
        La página que buscas no está aquí, pero la terraza sigue abierta.
      </p>
      <div class="btn-row" style="justify-content:center;margin-top:var(--sp-5)">
        <a class="btn btn--lg" href="/">Volver al inicio</a>
        <a class="btn btn--ghost btn--lg" href={telLink}>Reservar</a>
      </div>
    </div>
  </section>
</Base>
