---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import { telLink, waLink, site } from '../data/site';

import huevosRotos from '../assets/huevos-rotos.png';
import croquetas from '../assets/croquetas.png';
import raboDeToro from '../assets/rabo-de-toro.jpg';
import tortilla from '../assets/tortilla.png';
import hamburguesa from '../assets/hamburguesa.png';
import tarta from '../assets/tarta-queso.jpg';

// SOLO fotos reales del cliente (mapa en /assets/manifest.json). No se inventa ninguna.
const gallery = [
  { img: huevosRotos, label: 'Huevos rotos', alt: 'Plato de huevos rotos de Bar Las Chimeneas, para compartir.', tall: true },
  { img: croquetas, label: 'Croquetas caseras', alt: 'Ración de croquetas caseras.' },
  { img: raboDeToro, label: 'Rabo de toro al vino tinto', alt: 'Rabo de toro guisado en salsa de vino tinto.' },
  { img: tortilla, label: 'Tortilla de la casa', alt: 'Tortilla de patata casera.', tall: true },
  { img: hamburguesa, label: 'Hamburguesa gourmet', alt: 'Hamburguesa gourmet de la carta.' },
  { img: tarta, label: 'Tarta de queso casera', alt: 'Tarta de queso casera con mermelada de arándanos.' },
];

const faq = [
  {
    q: '¿Tenéis menú del día en Valdemorillo?',
    a: 'Sí. Nuestro menú del día cuesta 13,90 € e incluye primer plato, segundo plato, bebida y postre. Los platos concretos van cambiando cada día; consúltanos por WhatsApp o al llegar qué hay hoy.',
  },
  {
    q: '¿Dónde puedo ver los platos y precios de la carta?',
    a: 'Como nuestra propuesta cambia según la temporada y el producto, te recomendamos consultar la carta del día directamente en el bar o llamándonos por teléfono. Así te contamos lo más fresco de cada jornada.',
  },
  {
    q: '¿Hay opciones vegetarianas o sin gluten?',
    a: 'Disponemos de opciones vegetarianas y adaptamos algunos platos según tus necesidades. Si tienes una alergia o intolerancia, avísanos al reservar o al llegar y buscamos la mejor alternativa para ti.',
  },
  {
    q: '¿Se puede pedir comida para llevar?',
    a: 'Sí, ofrecemos comida para llevar. Escríbenos por WhatsApp con lo que te apetezca y te lo preparamos para recoger.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/\[.*?\]/g, '').trim() },
  })),
};

// Menú del día (dato real y visible en la página): 13,90 €.
const menuSchema = {
  '@context': 'https://schema.org',
  '@type': 'Menu',
  name: 'Menú del día — Bar Las Chimeneas',
  hasMenuSection: {
    '@type': 'MenuSection',
    name: 'Menú del día',
    description: 'Primer plato, segundo plato, bebida y postre. Recetas diferentes cada jornada.',
    offers: {
      '@type': 'Offer',
      price: '13.90',
      priceCurrency: 'EUR',
      availability: 'https://schema.org/InStock',
    },
  },
};
---

<Base
  title="Carta y menú del día en Valdemorillo | Bar Las Chimeneas"
  description="Descubre la carta de Bar Las Chimeneas en Valdemorillo: raciones caseras, tapas y platos para compartir. Consulta si hay menú del día y opciones para todos."
  path="/carta"
  schema={[menuSchema, faqSchema]}
>
  <!-- Encabezado -->
  <section class="section--tight page-head">
    <div class="container">
      <span class="eyebrow" data-reveal>La carta</span>
      <h1 class="display" data-reveal>Carta y menú del día en Valdemorillo</h1>
      <p class="lead" data-reveal style="--reveal-delay:80ms">
        En Bar Las Chimeneas, en el corazón de la Casa de la Cultura de Valdemorillo, cocinamos
        raciones caseras que combinan la tradición de las tapas madrileñas con toques creativos.
        Cada plato está pensado para compartir en mesa, ya sea en el interior o en nuestra terraza.
        Aquí tienes la carta para decidir con tranquilidad qué te apetece antes de venir.
      </p>
    </div>
  </section>

  <!-- Menú del día -->
  <section class="section paper">
    <div class="container split">
      <aside class="pizarra" data-reveal aria-label="Menú del día">
        <span class="pizarra__hand">el de cada día</span>
        <h2 class="pizarra__title">Menú del día</h2>
        <p class="pizarra__price">13,90 €</p>
        <ul class="pizarra__list">
          <li>Primer plato</li>
          <li>Segundo plato</li>
          <li>Bebida</li>
          <li>Postre</li>
        </ul>
        <p class="pizarra__foot">Comer bien sin complicarte, en el corazón de Valdemorillo.</p>
      </aside>
      <div class="split__copy" data-reveal style="--reveal-delay:80ms">
        <span class="eyebrow">Cada día</span>
        <h2 class="h-lg">Menú del día en Valdemorillo</h2>
        <div class="prose">
          <p>
            El menú del día es la forma más cómoda de comer bien sin complicarte: primer plato,
            segundo plato, bebida y postre por <strong>13,90&nbsp;€</strong>. Los platos concretos
            van cambiando cada día, así que lo mejor es preguntarnos por WhatsApp o al llegar qué
            hay hoy.
          </p>
        </div>
        <p class="pending">
          ¿Quieres saber el menú de hoy? Escríbenos por WhatsApp y te contamos los platos del día.
        </p>
      </div>
    </div>
  </section>

  <!-- Raciones y tapas + galería -->
  <section class="section">
    <div class="container">
      <div class="two two--head" data-reveal>
        <div>
          <span class="eyebrow">Para compartir</span>
          <h2 class="h-xl">Raciones y tapas para picar</h2>
        </div>
        <p class="prose">
          Nuestra propuesta gira en torno a las raciones caseras y las tapas para compartir, con
          producto cuidado y platos pensados para acompañar una caña, un vermut o un buen refresco.
          Consúltanos la carta del día y los precios directamente en el bar o por teléfono; nuestra
          propuesta cambia según el mercado y la temporada.
        </p>
      </div>
      <p class="pending">Nuestra carta cambia con la temporada y el mercado. Te contamos los platos del día y sus precios en el bar o por WhatsApp.</p>

      <ul class="masonry">
        {
          gallery.map((g, i) => (
            <li class:list={['masonry__item', { 'masonry__item--tall': g.tall }]} data-reveal style={`--reveal-delay:${i * 45}ms`}>
              <div class="frame">
                <Image src={g.img} alt={g.alt} width={480} height={g.tall ? 640 : 360} format="webp" densities={[1, 2]} quality={82} loading="lazy" />
                <span class="frame__cap">{g.label}</span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Opciones + para llevar -->
  <section class="section paper">
    <div class="container two-col">
      <article data-reveal>
        <h2 class="h-lg">Opciones para todos</h2>
        <div class="prose">
          <p>
            Disponemos de <strong>opciones vegetarianas</strong> y adaptamos algunos platos según
            las necesidades de cada cliente. Si tienes una alergia o intolerancia, avísanos al
            reservar o al llegar y te indicamos qué podemos prepararte.
          </p>
        </div>
        <p class="pending">
          ¿Tienes una alergia o preferencia concreta? Coméntanoslo al reservar o al llegar y
          buscamos la mejor opción para ti.
        </p>
      </article>
      <article data-reveal style="--reveal-delay:80ms">
        <h2 class="h-lg">Para llevar</h2>
        <div class="prose">
          <p>
            Sí, <strong>ofrecemos comida para llevar</strong>: puedes disfrutar de nuestras
            raciones en casa. Escríbenos por WhatsApp con lo que te apetezca y te lo preparamos.
          </p>
        </div>
    </div>
  </section>

  <!-- Reserva -->
  <section class="section section--tight cta-band">
    <div class="container cta-band__inner" data-reveal>
      <div>
        <h2 class="h-lg">Reserva tu mesa</h2>
        <p class="prose">
          La terraza suele tener plazas limitadas, sobre todo los fines de semana y los días con
          menú o evento en directo. Reserva mesa por WhatsApp o desde la web para asegurarte tu sitio.
          Horario: {site.hoursDisplay}.
        </p>
      </div>
      <div class="btn-row">
        <a class="btn btn--lg" href={waLink}>Reservar por WhatsApp</a>
        <a class="btn btn--ghost btn--lg" href={telLink}>Llamar al {site.phoneDisplay}</a>
      </div>
    </div>
  </section>

  <Faq items={faq} />
</Base>

<style>
  .page-head {
    padding-top: clamp(var(--sp-7), 6vw, var(--sp-8));
  }
  .page-head .display {
    margin: var(--sp-4) 0 var(--sp-5);
    max-width: 18ch;
  }
  .page-head .lead {
    max-width: 60ch;
  }

  .split {
    display: grid;
    grid-template-columns: 0.75fr 1.25fr;
    gap: clamp(var(--sp-6), 5vw, var(--sp-8));
    align-items: center;
  }
  .split__copy h2 {
    margin: var(--sp-3) 0 var(--sp-4);
  }
  /* estilos de .pizarra* en global.css (se comparten con la home) */

  .two {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(var(--sp-5), 4vw, var(--sp-8));
    align-items: end;
  }
  .two h2 {
    margin-top: var(--sp-3);
  }
  .two--head {
    margin-bottom: var(--sp-5);
  }

  .masonry {
    list-style: none;
    padding: 0;
    margin-top: var(--sp-6);
    columns: 3;
    column-gap: var(--sp-4);
  }
  .masonry__item {
    break-inside: avoid;
    margin-bottom: var(--sp-4);
  }
  .masonry__item .frame {
    aspect-ratio: 4 / 3;
  }
  .masonry__item--tall .frame {
    aspect-ratio: 3 / 4;
  }

  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(var(--sp-6), 5vw, var(--sp-8));
  }
  .two-col h2 {
    margin-bottom: var(--sp-4);
  }

  .cta-band__inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--sp-6);
    align-items: center;
    padding: clamp(var(--sp-6), 4vw, var(--sp-7));
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
  }
  .cta-band__inner h2 {
    margin-bottom: var(--sp-3);
  }
  .cta-band__inner .btn-row {
    justify-content: flex-end;
  }

  @media (max-width: 900px) {
    .masonry {
      columns: 2;
    }
  }
  @media (max-width: 780px) {
    .split,
    .two,
    .two-col,
    .cta-band__inner {
      grid-template-columns: 1fr;
    }
    .cta-band__inner .btn-row {
      justify-content: flex-start;
    }
    .menu-poster {
      max-width: 320px;
      margin-inline: auto;
    }
  }
  @media (max-width: 480px) {
    .masonry {
      columns: 1;
    }
  }
</style>
